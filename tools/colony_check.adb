         end;
         Index_All;
         Ripe_0 := Berries_Left;
         for I in 1 .. 6 loop
            Set_Job (I, Gatherer);
         end loop;
         for S in 1 .. 240 loop
            Run (1);
            declare
               N : Natural := 0;
            begin
               for I in 1 .. Members loop
                  if Doing (I) = Picking then
                     N := N + 1;
                  end if;
                  if S > 20 and then Status (I) = "the bushes near are being picked by others" then
