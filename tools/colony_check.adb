   for Share in Boolean loop
      declare
         Most, Taken_Said, Reach_Said : Natural := 0;
         Ripe_0 : Natural;
      begin
         Reset;
         Set_Beds (False);
         Set_Labour (False);
         Set_Needs (False);
         Set_Skills (False);
         Set_Demand_Chain (False);
