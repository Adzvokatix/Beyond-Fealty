   Run (300);
   Check (Stored (Berries) > 0, "a stockpile of eight places keeps none (a tenth at most): the band brings in"
          & Stored (Berries)'Image & " berries");

   Put_Line ("the playtest round: the stockpile placed once, ten metres square:");
